generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model InventoryModel {
  id         String @id
  sku        String
  locationId String @default("default")
  quantity   Int
  allocated  Int    @default(0)
  inTransit  Int    @default(0)
  version    Int    @default(1)

  @@unique([sku, locationId])
}

model BarcodeAssignmentModel {
  id           String   @id
  variantId    String
  barcodeValue String   @unique
  symbology    String
  source       String
  isPrimary    Boolean  @default(false)
  assignedAt   DateTime @default(now())
}

model ProductModel {
  id       String                @id
  name     String
  variants ProductVariantModel[]
}

model ProductVariantModel {
  id                String       @id
  productId         String
  sku               String       @unique
  attributes        String // Serialized variant attributes JSON string (e.g. [{"name":"size","value":"M"}])
  weightGrams       Int?
  volumeCubicMeters Float?
  product           ProductModel @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SerializedItemModel {
  id           String                  @id
  serialNumber String
  sku          String
  status       String
  locationId   String
  tenantId     String
  registeredAt DateTime                @default(now())
  transitions  StatusTransitionModel[]

  @@unique([serialNumber, tenantId])
}

model StatusTransitionModel {
  id               String              @id
  serializedItemId String
  fromStatus       String
  toStatus         String
  reason           String?
  transitionedAt   DateTime
  actorId          String
  referenceId      String?
  serializedItem   SerializedItemModel @relation(fields: [serializedItemId], references: [id], onDelete: Cascade)
}

model KitModel {
  id         String              @id
  sku        String              @unique
  name       String
  components KitComponentModel[]
}

model KitComponentModel {
  id        String   @id
  kitId     String
  variantId String
  quantity  Int
  kit       KitModel @relation(fields: [kitId], references: [id], onDelete: Cascade)
}

model InventoryCostLayerModel {
  id                String    @id
  variantId         String
  locationId        String?
  tenantId          String
  originalQuantity  Int
  remainingQuantity Int
  unitCostCents     Int
  receivedAt        DateTime
  purchaseOrderId   String
  isConsumed        Boolean   @default(false)
  lotNumber         String?
  expirationDate    DateTime?
}

model JournalEntryModel {
  id               String             @id
  tenantId         String
  entryDate        DateTime
  description      String
  referenceId      String?
  accountingMethod String
  lines            JournalLineModel[]
}

model JournalLineModel {
  id              String            @id
  journalEntryId  String
  accountCode     String
  accountName     String
  accountCategory String
  debitOrCredit   String
  amountCents     Int
  memo            String?
  journalEntry    JournalEntryModel @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
}

model TenantConfigModel {
  tenantId         String @id
  accountingMethod String
  costingMethod    String
  currencyCode     String
  fiscalYearStart  String
}

model ProcessedWebhookModel {
  id          String   @id
  processedAt DateTime @default(now())
}

model OutboxEventModel {
  id            String    @id @default(uuid())
  eventName     String
  payload       String
  occurredOn    DateTime
  processedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now())
}

model WebhookSubscriptionModel {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  targetUrl  String   @map("target_url")
  secret     String
  eventTypes String[] @map("event_types")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("webhook_subscriptions")
}

model WebhookDeliveryModel {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  subscriptionId String    @map("subscription_id")
  eventType      String    @map("event_type")
  payload        String    @db.Text
  status         String    @default("Pending")
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.Text
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at")
  processedAt    DateTime? @map("processed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("webhook_deliveries")
}

model PurchaseOrderModel {
  id                  String                   @id
  purchaseOrderNumber String                   @unique
  vendorId            String
  tenantId            String
  status              String
  locationId          String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  items               PurchaseOrderItemModel[]
}

model PurchaseOrderItemModel {
  id               String             @id
  purchaseOrderId  String
  variantId        String
  quantity         Int
  receivedQuantity Int                @default(0)
  unitCostCents    Int
  purchaseOrder    PurchaseOrderModel @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model ReorderPolicyModel {
  id                String   @id
  sku               String
  locationId        String
  reorderPoint      Int
  reorderQuantity   Int
  safetyStock       Int
  dynamicRopEnabled Boolean  @default(false) @map("dynamic_rop_enabled")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([sku, locationId])
}

model InventoryAuditModel {
  id          String                    @id
  auditNumber String                    @unique
  tenantId    String
  locationId  String
  status      String
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  items       InventoryAuditItemModel[]
}

model InventoryAuditItemModel {
  id               String              @id
  inventoryAuditId String
  variantId        String
  expectedQuantity Int
  countedQuantity  Int?
  isCounted        Boolean             @default(false)
  inventoryAudit   InventoryAuditModel @relation(fields: [inventoryAuditId], references: [id], onDelete: Cascade)
}

model RMAModel {
  id         String         @id
  rmaNumber  String         @unique
  tenantId   String
  customerId String
  locationId String
  status     String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  items      RMAItemModel[]
}

model RMAItemModel {
  id               String   @id
  rmaId            String
  variantId        String
  quantity         Int
  receivedQuantity Int      @default(0)
  unitCostCents    Int
  status           String
  disposition      String?
  rma              RMAModel @relation(fields: [rmaId], references: [id], onDelete: Cascade)
}

model QuarantineItemModel {
  id         String    @id
  variantId  String
  quantity   Int
  reason     String
  status     String
  locationId String
  tenantId   String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model DispatchRecordModel {
  id           String   @default(uuid())
  sku          String
  locationId   String
  quantity     Int
  dispatchedAt DateTime @default(now()) @map("dispatched_at")
  lotNumber    String?

  @@id([id, dispatchedAt])
  @@map("dispatch_records")
}

model DemandForecastModel {
  id                 String   @id @default(uuid())
  sku                String
  locationId         String
  forecastedQuantity Int
  periodStart        DateTime
  periodEnd          DateTime
  confidenceLevel    Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([sku, locationId, periodStart, periodEnd])
}

model ShipmentModel {
  id                 String   @id @default(uuid())
  sku                String
  quantity           Int
  destinationAddress String
  carrier            String
  trackingNumber     String?
  labelUrl           String?
  shippingRateCents  Int
  status             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model TenantModel {
  id          String      @id
  name        String
  createdAt   DateTime    @default(now())
  users       UserModel[]
  customRoles RoleModel[]
}

model UserModel {
  id           String          @id
  tenantId     String
  email        String
  passwordHash String
  name         String
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  tenant       TenantModel     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles    UserRoleModel[]
  apiTokens    ApiTokenModel[]

  @@unique([tenantId, email])
}

model RoleModel {
  id              String                @id
  name            String
  description     String                @default("")
  isCustom        Boolean               @default(false) @map("is_custom")
  tenantId        String?               @map("tenant_id")
  userRoles       UserRoleModel[]
  rolePermissions RolePermissionModel[]
  tenant          TenantModel?          @relation(fields: [tenantId], references: [id])
}

model PermissionModel {
  id              String                @id
  resource        String
  action          String
  description     String                @default("")
  rolePermissions RolePermissionModel[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRoleModel {
  userId String
  roleId String
  user   UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   RoleModel @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermissionModel {
  roleId       String
  permissionId String
  role         RoleModel       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   PermissionModel @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model ApiTokenModel {
  id        String    @id
  userId    String
  tenantId  String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WarehouseLocationModel {
  id                   String   @id // e.g. "WH1-ZONEA-A03-R02-S01-B10"
  warehouseId          String
  zone                 String
  aisle                String
  rack                 String
  shelf                String
  bin                  String
  maxWeightGrams       Int
  maxVolumeCubicMeters Float
  gridX                Int      @default(0)
  gridY                Int      @default(0)
  width                Int      @default(1)
  height               Int      @default(1)
  createdAt            DateTime @default(now())

  @@unique([warehouseId, zone, aisle, rack, shelf, bin])
}

model NotificationModel {
  id        String   @id @default(uuid())
  tenantId  String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NetsuiteJournalMappingModel {
  id                String   @id @default(uuid())
  journalEntryId    String   @unique
  netsuiteJournalId String   @unique
  createdAt         DateTime @default(now())
}

model XeroJournalMappingModel {
  id             String   @id @default(uuid())
  journalEntryId String   @unique
  xeroJournalId  String   @unique
  createdAt      DateTime @default(now())
}

model QuickbooksJournalMappingModel {
  id                  String   @id @default(uuid())
  journalEntryId      String   @unique
  quickbooksJournalId String   @unique
  createdAt           DateTime @default(now())
}

model AuditDiscrepancyModel {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  type            String
  referenceId     String    @map("reference_id")
  externalRefId   String?   @map("external_ref_id")
  description     String
  status          String    @default("OPEN")
  occurredAt      DateTime  @default(now()) @map("occurred_at")
  resolvedAt      DateTime? @map("resolved_at")
  resolutionNotes String?   @map("resolution_notes")

  @@map("audit_discrepancies")
}

model ComplianceLedgerModel {
  id             String   @id @default(uuid())
  sequenceNumber Int      @unique
  tenantId       String
  eventType      String
  payload        String   @db.Text
  timestamp      DateTime @default(now())
  previousHash   String
  hash           String
  signature      String
}

model RfidTagModel {
  epc          String    @id
  sku          String
  serialNumber String    @map("serial_number")
  status       String    @default("ACTIVE")
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz
  lastLocation String?   @map("last_location")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("rfid_tags")
}

model LotBatchModel {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  lotNumber        String    @map("lot_number")
  variantId        String    @map("variant_id")
  status           String    @default("ACTIVE")
  manufacturedDate DateTime? @map("manufactured_date")
  expirationDate   DateTime? @map("expiration_date")
  supplierId       String?   @map("supplier_id")
  quarantinedAt    DateTime? @map("quarantined_at")
  quarantineReason String?   @map("quarantine_reason")
  recalledAt       DateTime? @map("recalled_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, lotNumber, variantId])
  @@map("lot_batches")
}

model BillOfLading {
  id                 String   @id @default(uuid())
  bolNumber          String   @unique @map("bol_number")
  carrier            String
  originAddress      String   @map("origin_address")
  destinationAddress String   @map("destination_address")
  weightKg           Float    @map("weight_kg")
  totalPackages      Int      @map("total_packages")
  status             String   @default("GENERATED")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("bills_of_lading")
}

model ReturnMerchandiseAuthorization {
  id         String    @id @default(uuid())
  rmaNumber  String    @unique @map("rma_number")
  orderId    String    @map("order_id")
  customerId String    @map("customer_id")
  status     String    @default("PENDING_INSPECTION")
  createdAt  DateTime  @default(now()) @map("created_at")
  items      RmaItem[]

  @@map("return_merchandise_authorizations")
}

model RmaItem {
  id          String                         @id @default(uuid())
  rmaId       String                         @map("rma_id")
  sku         String
  quantity    Int
  reason      String
  disposition String                         @default("PENDING")
  inspectedAt DateTime?                      @map("inspected_at")
  rma         ReturnMerchandiseAuthorization @relation(fields: [rmaId], references: [id], onDelete: Cascade)

  @@map("rma_items")
}

model SupplierASN {
  id               String    @id @default(uuid())
  asnNumber        String    @unique @map("asn_number")
  supplierId       String    @map("supplier_id")
  expectedDelivery DateTime  @map("expected_delivery")
  actualDelivery   DateTime? @map("actual_delivery")
  status           String    @default("IN_TRANSIT")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("supplier_asns")
}

model SupplierScorecard {
  id          String   @id @default(uuid())
  supplierId  String   @map("supplier_id")
  onTimeRate  Float    @map("on_time_rate")
  inFullRate  Float    @map("in_full_rate")
  defectRate  Float    @map("defect_rate")
  otifScore   Float    @map("otif_score")
  evaluatedAt DateTime @default(now()) @map("evaluated_at")

  @@map("supplier_scorecards")
}

model EsgEmissionsRecord {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  transportMode String   @map("transport_mode")
  distanceKm    Float    @map("distance_km")
  weightKg      Float    @map("weight_kg")
  tonKm         Float    @map("ton_km")
  co2eKg        Float    @map("co2e_kg")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("esg_emissions_records")
}

model ReportDefinitionModel {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  type        String
  filters     String   @db.Text
  grouping    String?  @db.Text
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  schedules  ReportScheduleModel[]
  executions ReportExecutionModel[]

  @@map("report_definitions")
}

model ReportScheduleModel {
  id                 String    @id @default(uuid())
  reportDefinitionId String    @map("report_definition_id")
  cronExpression     String    @map("cron_expression")
  nextRunAt          DateTime  @map("next_run_at")
  lastRunAt          DateTime? @map("last_run_at")
  status             String    @default("ACTIVE")
  deliveryMethod     String    @default("INTERNAL") @map("delivery_method")

  reportDefinition ReportDefinitionModel @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)

  @@map("report_schedules")
}

model ReportExecutionModel {
  id                 String    @id @default(uuid())
  reportDefinitionId String    @map("report_definition_id")
  startedAt          DateTime  @default(now()) @map("started_at")
  completedAt        DateTime? @map("completed_at")
  status             String    @default("PENDING")
  fileUrl            String?   @map("file_url")
  format             String
  error              String?   @db.Text

  reportDefinition ReportDefinitionModel   @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  sharedLinks      SharedReportLinkModel[]

  @@map("report_executions")
}

model SharedReportLinkModel {
  id                String   @id @default(uuid())
  reportExecutionId String   @map("report_execution_id")
  token             String   @unique
  expiresAt         DateTime @map("expires_at")
  viewerPermissions String?  @map("viewer_permissions")

  reportExecution ReportExecutionModel @relation(fields: [reportExecutionId], references: [id], onDelete: Cascade)

  @@map("shared_report_links")
}

model DashboardWidgetModel {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  type     String
  config   String @db.Text
  layoutX  Int    @default(0) @map("layout_x")
  layoutY  Int    @default(0) @map("layout_y")
  width    Int    @default(1)
  height   Int    @default(1)

  @@map("dashboard_widgets")
}

model ApprovalWorkflowModel {
  id           String   @id
  tenantId     String   @map("tenant_id")
  name         String
  triggerEvent String   @map("trigger_event")
  config       String   @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  requests ApprovalRequestModel[]

  @@map("approval_workflows")
}

model ApprovalRequestModel {
  id          String   @id
  tenantId    String   @map("tenant_id")
  workflowId  String   @map("workflow_id")
  status      String   @default("PENDING")
  currentStep Int      @default(0) @map("current_step")
  createdAt   DateTime @default(now()) @map("created_at")

  workflow  ApprovalWorkflowModel   @relation(fields: [workflowId], references: [id])
  decisions ApprovalDecisionModel[]

  @@map("approval_requests")
}

model ApprovalDecisionModel {
  id        String   @id
  requestId String   @map("request_id")
  stepIndex Int      @map("step_index")
  deciderId String   @map("decider_id")
  decision  String
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  request ApprovalRequestModel @relation(fields: [requestId], references: [id])

  @@map("approval_decisions")
}

model CycleCountPlanModel {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  name              String
  abcClassification String   @map("abc_classification") // e.g. "A", "B", "C"
  frequencyDays     Int      @map("frequency_days")
  zone              String?
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("cycle_count_plans")
}

model NotificationPreferenceModel {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  channel   String // "EMAIL", "SMS", "IN_APP", "WEBHOOK"
  eventType String   @map("event_type") // e.g. "LOW_STOCK", "ALL"
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, channel, eventType])
  @@map("notification_preferences")
}


model LegalEntityModel {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  name           String
  baseCurrency   String   @map("base_currency")
  taxIdentifier  String?  @map("tax_identifier")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("legal_entities")
}

model IntercompanyTransferModel {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  fromEntityId     String   @map("from_entity_id")
  toEntityId       String   @map("to_entity_id")
  sku              String
  quantity         Int
  transferPrice    Int      @map("transfer_price") // in cents
  dutyCents        Int      @default(0) @map("duty_cents")
  status           String   @default("COMPLETED")
  journalEntryId   String?  @map("journal_entry_id") // Reference to elimination journal entry
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("intercompany_transfers")
}

model ApiUsageMetricModel {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  date      DateTime @db.Date
  metric    String   // e.g., 'API_REQUESTS', 'STORAGE'
  value     Int      @default(0)

  @@unique([tenantId, date, metric])
  @@map("api_usage_metrics")
}
